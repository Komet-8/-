# ===== 火山方舟 / 豆包 (Volcengine Ark / Doubao) =====
# 在 https://console.volcengine.com/ark 创建 API Key 和推理接入点后填写。
# 不填则后端自动以「模拟数据」模式运行，整条流程和界面照样能跑通。
ARK_API_KEY=

# OpenAI 兼容的 Ark 接入地址（一般无需修改）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型 ID 或推理接入点 ID。
#   - 可直接填豆包模型 ID，例如：doubao-1-5-pro-32k-250115 / doubao-pro-32k
#   - 也可填你创建的接入点 ID，例如：ep-20240xxxxxxxx-xxxxx
ARK_MODEL=doubao-1-5-pro-32k-250115

# ===== 诊断参数 =====
# 每次诊断自动生成的问题数量
NUM_QUESTIONS=5
# 单次模型调用超时（秒）
REQUEST_TIMEOUT=60
# 并发调用模型的线程数
MAX_WORKERS=5

# ===== 存储 =====
DATABASE_URL=sqlite:///./aidso.db
